<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape chrome matching the previous Flutter VisitVideoRecorderScreen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/native_camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />

    <View
        android:id="@+id/focus_reticle"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/native_camera_focus_reticle"
        android:visibility="gone" />

    <!-- Top chrome: close (left) + recording badge (center).
         Elevation keeps Close above the portrait scrim. -->
    <FrameLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:elevation="12dp"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/native_camera_circle_scrim"
            android:contentDescription="@string/native_camera_close"
            android:padding="10dp"
            android:src="@drawable/native_camera_ic_close"
            android:tint="#FFFFFFFF" />

        <LinearLayout
            android:id="@+id/recording_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/native_camera_glass_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/native_camera_rec_dot" />

            <TextView
                android:id="@+id/recording_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="0:00"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/extension_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/native_camera_glass_pill"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textColor="#FFE8F5E9"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Extension mode chips (STD / AUTO / HDR / NIGHT). Populated in code
         from the modes the device actually advertises. -->
    <LinearLayout
        android:id="@+id/extension_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="18dp"
        android:layout_marginTop="62dp"
        android:background="@drawable/native_camera_zoom_rail_bg"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingTop="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone" />

    <!-- Exposure compensation (EV) stepper. -->
    <LinearLayout
        android:id="@+id/exposure_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/native_camera_glass_pill"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="5dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_exposure_down"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/native_camera_zoom_chip"
            android:contentDescription="@string/native_camera_exposure_down"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/native_camera_exposure_minus"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/exposure_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:minWidth="42dp"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_exposure_up"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/native_camera_zoom_chip"
            android:contentDescription="@string/native_camera_exposure_up"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/native_camera_exposure_plus"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right chrome rail (previous Flutter layout). Extra end padding
         applied in code from system insets + Android chrome inset. -->
    <LinearLayout
        android:id="@+id/right_chrome"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="36dp">

        <LinearLayout
            android:id="@+id/zoom_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/native_camera_zoom_rail_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="5dp"
            android:paddingTop="6dp"
            android:paddingEnd="5dp"
            android:paddingBottom="6dp" />

        <FrameLayout
            android:id="@+id/shutter_rail"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp">

            <ImageButton
                android:id="@+id/btn_flash"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/native_camera_circle_scrim"
                android:contentDescription="@string/native_camera_flash"
                android:padding="10dp"
                android:src="@drawable/native_camera_ic_flash_off"
                android:tint="#FFFFFFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/capture_hint"
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="44dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.05"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="8"
                android:text="@string/native_camera_hint_idle"
                android:textColor="#EBFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_shutter"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/native_camera_shutter"
                android:contentDescription="@string/native_camera_shutter"
                android:padding="18dp"
                android:scaleType="centerInside"
                android:src="@drawable/native_camera_ic_shutter"
                android:tint="#FF022A67" />

            <!-- Kept for Activity code compatibility; unused in this chrome. -->
            <ImageButton
                android:id="@+id/btn_stop"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Hidden legacy controls kept so Activity findViewById stays stable. -->
    <TextView
        android:id="@+id/btn_mode_photo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btn_mode_video"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_flip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/zoom_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/busy_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/native_camera_glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFE48E15" />

        <TextView
            android:id="@+id/busy_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/native_camera_busy_capturing"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/native_camera_toast_bg"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Same prompt as Flutter VisitOrientationPromptOverlay -->
    <FrameLayout
        android:id="@+id/portrait_block_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/native_camera_orientation_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/native_camera_orientation_icon_bg">

                <ImageView
                    android:id="@+id/portrait_block_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/native_camera_ic_rotate"
                    android:tint="#FFE48E15" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/native_camera_landscape_title"
                android:textColor="#FFF1F5F9"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:text="@string/native_camera_landscape_message"
                android:textColor="#FFCBD5E1"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
